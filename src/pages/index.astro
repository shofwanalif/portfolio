---
import Layout from "@/layouts/Layout.astro";
import SectionWrapper from "@/components/SectionWrapper.astro";
import { HeroSection } from "@/components/sections/HeroSection";
import { Project } from "@/components/sections/Project";
import { TechStack } from "@/components/sections/TechStack";
import { Experience } from "@/components/sections/Experience";
import { Navbar } from "@/components/Navbar";
import { ArrowUp } from "lucide-react";
---

<Layout>
  <SectionWrapper id="home" fullWidth={true}>
    <HeroSection client:load />
  </SectionWrapper>
  <SectionWrapper id="project">
    <Project client:load />
  </SectionWrapper>
  <SectionWrapper id="tech-stack" fullWidth={true} noPadding={true}>
    <TechStack client:load />
  </SectionWrapper>
  <SectionWrapper id="experience" fullWidth={true}>
    <Experience client:load />
  </SectionWrapper>

  <footer class="w-full px-6 py-8">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-1 text-sm text-muted-foreground">
        <span>&copy; 2026 Shofwan Alif Alfani</span>
        <span>Built With Astro and Tailwind</span>
      </div>
      <a
        href="#home"
        class="group flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary cursor-pointer"
      >
        Back To Top
        <ArrowUp
          className="h-4 w-4 transition-transform group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </footer>
  <Navbar client:load />
</Layout>
